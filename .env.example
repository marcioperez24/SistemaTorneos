# Ejemplo de Variables de Entorno para Producción - SistemaTorneos
# Copiar este archivo a .env y reemplazar los valores reales en el servidor

DJANGO_SECRET_KEY=cambiar_esta_clave_secreta_super_segura_en_produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=torneos.sysacadep.win,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://torneos.sysacadep.win

# Configuración de Base de Datos MySQL/MariaDB
DB_NAME=sistematorneos_db
DB_USER=sistematorneos_user
DB_PASSWORD=contrasena_segura_db
DB_HOST=127.0.0.1
DB_PORT=3306

# Ajustes de Seguridad HTTPS para Producción
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
